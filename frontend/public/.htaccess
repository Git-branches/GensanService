# Copied into dist/ by `npm run build`. Serves the React app and lets client-side routes
# like /services/some-guide or /admin load on refresh. Requests to /api go to the PHP backend.
Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^api(/|$) - [L]

    # Search engines read these at the site root; the API writes them.
    RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]
    RewriteRule ^robots\.txt$ /api/robots.txt [L]

    # Link previews (Facebook, Messenger, Viber, X, and others) do not run JavaScript, so they get the page
    # with its title, summary, and share image filled in by the API. People get the same page as always.
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebookcatalog|Facebot|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|Viber|SkypeUriPreview|Pinterest|redditbot|Applebot|Embedly) [NC]
    RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
    RewriteCond %{REQUEST_URI} !^/admin
    RewriteRule ^(.*)$ /api/share?path=/$1 [L,QSA]

    # Pre-built pages live in folders, such as faq/index.html.
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ shell.html [L]
</IfModule>

# Compress text files. The main script drops from about 420 KB to 125 KB.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Built assets have content hashes in their names, so they can be cached for a long time.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The offline worker and the app manifest must update as soon as a new version is deployed.
    <FilesMatch "^(sw\.js|manifest\.webmanifest|shell\.html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
