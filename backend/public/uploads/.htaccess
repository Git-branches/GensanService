# Uploaded images only (agency logos). Nothing in this folder may run as a script.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php\d*|phtml|phar|pl|py|cgi|sh|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
