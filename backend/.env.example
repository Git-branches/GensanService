# Copy this file to backend/.env and fill in the values.
#
# The defaults here are the safe ones for a live server. For local development only, set
# APP_ENV=local and APP_DEBUG=true so error details appear in the browser and the log.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.test
APP_TIMEZONE=Asia/Manila

# Use a dedicated database user, never root, on a live server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gensan_service_navigator
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Only needed when the frontend runs on a different origin (the Vite dev server). Leave empty in production.
CORS_ALLOWED_ORIGIN=

# Comma-separated IPs or CIDRs of reverse proxies/CDNs you control. Leave empty when the site is
# served directly. When set, X-Forwarded-For / CF-Connecting-IP are trusted only from these peers.
TRUSTED_PROXIES=

# The public site address for link previews, the sitemap, and canonical URLs, such as
# https://andamgensan.ph. Set this in production; leaving it empty uses the request's Host header.
SITE_URL=

# Both paths may be absolute (/home/vol1_2/example/htdocs) or relative to the project root.
# Where the built frontend lives. Leave empty when it is frontend/dist. On shared hosting the built
# site is the web root itself, so set the absolute path of that folder instead.
FRONTEND_DIST=
# Where agency logos are written, and the address they are served from. On shared hosting set the
# absolute path of the uploads folder inside the API folder.
UPLOADS_DIR=
UPLOADS_URL=/api/uploads

# A long random value (for example, `php -r "echo bin2hex(random_bytes(32));"`) that lets an
# external scheduler call POST /api/maintenance/run to delete old rows and rotate the log.
# Leave it empty to disable the endpoint.
MAINTENANCE_TOKEN=
