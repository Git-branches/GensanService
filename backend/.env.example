# Use APP_ENV=production and APP_DEBUG=false on a live server.
# In production, error details are written to storage/logs/app.log instead of being shown to visitors.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gensan_service_navigator
DB_USERNAME=root
DB_PASSWORD=

# Only needed when the frontend runs on a different origin (the Vite dev server). Leave empty in production.
CORS_ALLOWED_ORIGIN=http://localhost:5173
