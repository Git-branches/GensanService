# Template for InfinityFree (shared hosting). Copy to backend/.env on the server, not in the upload
# folder. Never commit the filled-in file.
#
# Paths: read the absolute path from the control panel. It looks like
# /home/vol1_2/if0_XXXXXXXX/htdocs.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN
APP_TIMEZONE=Asia/Manila

DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_andam
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=YOUR-DATABASE-PASSWORD

CORS_ALLOWED_ORIGIN=
TRUSTED_PROXIES=
SITE_URL=https://YOUR-DOMAIN

FRONTEND_DIST=/home/volX_Y/YOUR-ACCOUNT/htdocs
UPLOADS_DIR=/home/volX_Y/YOUR-ACCOUNT/htdocs/api/uploads
UPLOADS_URL=/api/uploads

# Generate with `php -r "echo bin2hex(random_bytes(32));"`. Used by the external cron job.
MAINTENANCE_TOKEN=
